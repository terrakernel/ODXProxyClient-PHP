{
    "name": "odxproxy/client",
    "description": "High performance PHP client for ODXProxy",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "OdxProxy\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "OdxProxy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:live": "phpunit tests/Live"
    }
}